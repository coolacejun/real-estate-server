# Copy to .env and fill values
TZ=Asia/Seoul
POSTGRES_DB=serverdb
POSTGRES_USER=serveruser
POSTGRES_PASSWORD=change_me
API_PORT=8000
ADMIN_TOKEN=change_me
CADASTRAL_TILE_VERSION=v1

# Optional: enables /v1/reports/site-plan GPT report generation.
# Without OPENAI_API_KEY the endpoint returns a deterministic server draft.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REPORT_MAX_COMPLETION_TOKENS=3500
OPENAI_REPORT_TIMEOUT_SEC=60
OPENAI_REPORT_DATA_LIMIT_CHARS=28000

# Optional: enables Kakao-based address search and PNU derivation.
KAKAO_REST_API_KEY=

# 건축HUB 건축물대장 자동 최신화 주기.
# 전월 데이터는 익월 20일 제공 기준입니다. 업로드 예상 시각부터 하루 1회 확인합니다.
BUILDING_HUB_SYNC_UPLOAD_DAY=20
BUILDING_HUB_SYNC_UPLOAD_CHECK_HOUR=13
BUILDING_HUB_SYNC_UPLOAD_WINDOW_DAYS=7
BUILDING_HUB_SYNC_WINDOW_INTERVAL_SECONDS=86400
BUILDING_HUB_SYNC_LATE_INTERVAL_SECONDS=86400
BUILDING_HUB_SYNC_INITIAL_DELAY_SECONDS=0
BUILDING_HUB_SYNC_POLL_INTERVAL_SECONDS=30
BUILDING_HUB_SYNC_IMPORT_TIMEOUT_SECONDS=14400
BUILDING_HUB_SYNC_RETRY_SECONDS=3600
BUILDING_HUB_SYNC_KEEP_SOURCE_FILES=0

# 연속지적 변동데이터 자동 최신화.
# 현재 활성 릴리즈에 반영되지 않은 CH_D002 증분만 받아 좌표 변환 후 update 적재합니다.
CADASTRAL_SYNC_CHECK_INTERVAL_SECONDS=86400
CADASTRAL_SYNC_RETRY_SECONDS=3600
CADASTRAL_SYNC_INITIAL_DELAY_SECONDS=0
CADASTRAL_SYNC_POLL_INTERVAL_SECONDS=30
CADASTRAL_SYNC_IMPORT_TIMEOUT_SECONDS=14400
CADASTRAL_SYNC_MAX_DIRECT_DOWNLOAD_MB=500
CADASTRAL_SYNC_CLEANUP_ON_SUCCESS=1
CADASTRAL_SYNC_MAX_FILES=0
VWORLD_USER_ID=
VWORLD_USER_PASSWORD=

# 건물통합정보 변동데이터 자동 최신화.
# 현재 활성 릴리즈에 반영되지 않은 CH_D010 증분만 받아 좌표 변환 후 update 적재합니다.
BUILDING_INTEGRATED_SYNC_CHECK_INTERVAL_SECONDS=86400
BUILDING_INTEGRATED_SYNC_RETRY_SECONDS=3600
BUILDING_INTEGRATED_SYNC_INITIAL_DELAY_SECONDS=0
BUILDING_INTEGRATED_SYNC_POLL_INTERVAL_SECONDS=30
BUILDING_INTEGRATED_SYNC_IMPORT_TIMEOUT_SECONDS=14400
BUILDING_INTEGRATED_SYNC_MAX_DIRECT_DOWNLOAD_MB=500
BUILDING_INTEGRATED_SYNC_CLEANUP_ON_SUCCESS=1
BUILDING_INTEGRATED_SYNC_MAX_FILES=0

# 토지이동(AL_D157) 변동데이터 자동 최신화.
# 토지정보 4종 중 VWorld CH 변동데이터가 제공되는 토지이동만 서버가 직접 증분 적재합니다.
LAND_MOVEMENT_SYNC_CHECK_INTERVAL_SECONDS=86400
LAND_MOVEMENT_SYNC_RETRY_SECONDS=3600
LAND_MOVEMENT_SYNC_INITIAL_DELAY_SECONDS=0
LAND_MOVEMENT_SYNC_POLL_INTERVAL_SECONDS=30
LAND_MOVEMENT_SYNC_IMPORT_TIMEOUT_SECONDS=14400
LAND_MOVEMENT_SYNC_MAX_DIRECT_DOWNLOAD_MB=500
LAND_MOVEMENT_SYNC_CLEANUP_ON_SUCCESS=1
LAND_MOVEMENT_SYNC_MAX_FILES=0
LAND_MOVEMENT_SYNC_IMPORT_BATCH_SIZE=2000

# 토지정보 전체데이터 자동 최신화.
# Windows 워커 공유 폴더에 요청 manifest를 쓰고, downloads에 4종 ZIP이 모두 들어오면 full 적재합니다.
LAND_INFO_WORKER_HOST_DIR=/Volumes/land-info-worker
LAND_INFO_SYNC_CHECK_INTERVAL_SECONDS=86400
LAND_INFO_SYNC_PENDING_INTERVAL_SECONDS=600
LAND_INFO_SYNC_RETRY_SECONDS=3600
LAND_INFO_SYNC_INITIAL_DELAY_SECONDS=0
LAND_INFO_SYNC_POLL_INTERVAL_SECONDS=30
LAND_INFO_SYNC_IMPORT_TIMEOUT_SECONDS=86400
LAND_INFO_SYNC_STABLE_SECONDS=60
LAND_INFO_SYNC_CLEANUP_ON_SUCCESS=1

# Optional (required for Cloudflare zone update APIs)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
