{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://building-land.com/contracts/canonical-report-v1.schema.json",
  "title": "Building Land Canonical Report v1",
  "type": "object",
  "required": ["schemaVersion", "rendererVersion", "includedItems", "pages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "rendererVersion": {
      "enum": ["web-a4-v1", "ios-a4-v1", "android-a4-v1", "web-a4-canonical-v1"]
    },
    "mappingVersion": {"type": "string", "maxLength": 120},
    "reportId": {"type": "string", "maxLength": 160},
    "title": {"type": "string", "maxLength": 240},
    "address": {"type": "string", "maxLength": 500},
    "includedItems": {
      "type": "array",
      "maxItems": 2000,
      "items": {"type": "string"}
    },
    "officeInfo": {"type": "object"},
    "reportTheme": {"type": "string"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "imageReference": {
      "type": "string",
      "pattern": "^(data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=\\r\\n]+|asset://[0-9a-f-]{36})$"
    },
    "page": {
      "type": "object",
      "required": ["pageKey", "layout"],
      "properties": {
        "pageKey": {"type": "string", "minLength": 1, "maxLength": 160},
        "layout": {"enum": ["cover", "property-report", "broker-disclosure", "opinion"]},
        "title": {"type": "string"},
        "address": {"type": "string"},
        "reportRows": {"type": "array"},
        "sourceRows": {"type": "array"},
        "brokerRows": {"type": "array"},
        "opinionText": {"type": "string"},
        "mapImage": {"$ref": "#/$defs/imageReference"},
        "opinionImages": {
          "type": "array",
          "maxItems": 6,
          "items": {"$ref": "#/$defs/imageReference"}
        }
      },
      "additionalProperties": true
    }
  }
}
